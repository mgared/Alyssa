# Copy to .env.local (for local dev) or add to your host's environment settings.
# Supabase dashboard -> Project Settings -> API (or "Connect").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable ("anon") key. It is safe in the browser; the access rules in
# supabase/schema.sql decide what it can do. Never use the secret/service_role key here.
VITE_SUPABASE_KEY=your-publishable-key
